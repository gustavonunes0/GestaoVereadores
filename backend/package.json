{
    "name": "gestao-vereadores-api",
    "version": "1.0.0",
    "description": "API NestJS — Atividade Legislativa (SIGL)",
    "private": true,
    "scripts": {
        "build": "node scripts/resolve-vercel-env.cjs && node scripts/prisma-generate.cjs && node scripts/prisma-migrate-deploy.cjs && nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "prisma:generate": "node scripts/prisma-generate.cjs",
        "prisma:migrate": "prisma migrate dev",
        "prisma:seed": "prisma db seed",
        "prisma:studio": "prisma studio",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:deploy": "node scripts/prisma-deploy-prod.cjs",
        "vercel-build": "npm run build",
        "test": "jest",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "postinstall": "node scripts/resolve-vercel-env.cjs && node scripts/prisma-generate.cjs"
    },
    "dependencies": {
        "@fastify/multipart": "^10.0.0",
        "@fastify/static": "^9.1.3",
        "@fastify/under-pressure": "^9.0.3",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "^2.1.1",
        "@nestjs/passport": "^11.0.0",
        "@nestjs/platform-fastify": "^11.1.26",
        "@nestjs/platform-socket.io": "^11.1.27",
        "@nestjs/swagger": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/websockets": "^11.1.27",
        "@prisma/adapter-pg": "^6.19.3",
        "@prisma/client": "^6.0.0",
        "bcryptjs": "^3.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.21.0",
        "prisma": "^6.0.0",
        "puppeteer": "^25.4.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "socket.io": "^4.8.3",
        "web-push": "^3.6.7"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/testing": "^11.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^6.0.2",
        "@types/web-push": "^3.6.4",
        "autocannon": "^8.0.0",
        "clinic": "^13.0.0",
        "jest": "^29.7.0",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    },
    "allowScripts": {
        "puppeteer@25.4.0": true
    },
    "prisma": {
        "seed": "ts-node --transpile-only --compiler-options {\"module\":\"CommonJS\",\"rootDir\":\".\"} prisma/seed.ts"
    }
}
