# ── Desenvolvimento local ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gestao_vereadores?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gestao_vereadores?schema=public"

PORT=3000
JWT_SECRET="altere-esta-chave-em-producao"
CORS_ORIGIN="http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080"

# --------------------------------------------------------------------------
# Jitsi Meet
# --------------------------------------------------------------------------
# JITSI_DOMAIN = host (e porta se necessário) acessível no navegador, SEM https://
#
# Exemplos:
#   Local self-hosted (docker na máquina):   localhost:8444
#   Rede local (outro PC/tablet):            192.168.100.7:8444
#   Produção self-hosted com TLS válido:     meet.baturite.stellarsolucoes.com.br
#   Jitsi Meet público (sem Docker):         meet.jit.si
#
# Produção (API em apibaturite.stellarsolucoes.com.br):
#   defina JITSI_DOMAIN no painel/ambiente DO SERVIDOR da API — se ficar
#   "localhost:8444", o usuário tenta abrir o Jitsi na própria máquina dele.
#
# JITSI_APP_ID / JITSI_APP_SECRET devem ser iguais a JWT_APP_ID / JWT_APP_SECRET
# no .env da raiz (docker-compose) quando for self-hosted com JWT.
# JITSI_SUB: self-hosted = meet.jitsi · meet.jit.si = *
# --------------------------------------------------------------------------
JITSI_DOMAIN="localhost:8444"
JITSI_APP_ID="gestao_vereadores"
JITSI_APP_SECRET="troque-por-um-segredo-forte-de-32-bytes"
JITSI_SUB="meet.jitsi"
# --------------------------------------------------------------------------
# Web Push (PWA) — notifica vereadores ao abrir sessão
# Gere as chaves com: npx web-push generate-vapid-keys
# No frontend, use a mesma pública em VITE_VAPID_PUBLIC_KEY
# --------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@sua-camara.gov.br"

# gestaovereadores_PRISMA_DATABASE_URL  →  mapeada para DATABASE_URL
# gestaovereadores_POSTGRES_URL         →  mapeada para DIRECT_DATABASE_URL
#
# Ainda configure manualmente no projeto backend:
# JWT_SECRET=chave-forte-aleatoria
# CORS_ORIGIN=https://baturite.stellarsolucoes.com.br
# API pública: https://apibaturite.stellarsolucoes.com.br/
# (previews *.vercel.app já são aceitos automaticamente pelo backend)
