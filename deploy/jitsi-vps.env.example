# =============================================================================
# Jitsi + API — produção VPS (self-host via NPM)
# NÃO commit secrets reais. Na VPS: raiz `.env` + `docker-compose.override.yml`.
# =============================================================================

# --- Meet público (DNS Registro.br → 187.127.42.128; TLS no NPM) ---
# Domínio real: meet.stashsoftware.com.br
# Guia: docs/deploy-vps.md (seção Jitsi / Meet)

JITSI_PUBLIC_HOST=meet.stashsoftware.com.br
# URL completa sem porta (TLS termina no NPM :443)
JITSI_PUBLIC_URL=https://meet.stashsoftware.com.br
# O que o navegador usa no token da API (sem https://)
JITSI_DOMAIN=meet.stashsoftware.com.br

# JVB / NAT — IP público da VPS (mídia UDP, não passa pelo NPM)
DOCKER_HOST_ADDRESS=187.127.42.128
JITSI_HTTP_PORT=8000
JITSI_HTTPS_PORT=8444
JVB_PORT=10000
TZ=America/Sao_Paulo

# JWT — o MESMO par na API e em jitsi-web / jitsi-prosody
JWT_APP_ID=gestao_vereadores
JWT_APP_SECRET=troque-por-um-segredo-forte

# Senhas internas Jitsi (troque se ainda forem placeholder)
JICOFO_AUTH_PASSWORD=troque-jicofo
JVB_AUTH_PASSWORD=troque-jvb
JIGASI_XMPP_PASSWORD=troque-jigasi
JIBRI_RECORDER_PASSWORD=troque-jibri-recorder
JIBRI_XMPP_PASSWORD=troque-jibri

# Espelho explícito no container API (override pode forçar estes)
JITSI_APP_ID=gestao_vereadores
JITSI_APP_SECRET=troque-por-um-segredo-forte
JITSI_SUB=*
# Proibido em produção: meet.jit.si | localhost:8444 | IP:8444 (self-signed)

CORS_ORIGIN=https://camaragest.stellarsolucoes.com.br,https://baturite.stellarsolucoes.com.br,http://localhost:5173

PLATFORM_SEED_HOSTS=camaragest.stellarsolucoes.com.br
TENANT_SEED_HOSTS=baturite.stellarsolucoes.com.br

# --- Web Push (PWA) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@sigl.app
