# Dev local (API no :3000; Vite faz proxy de /api)
VITE_API_URL=http://127.0.0.1:3000/api

# Web Push — mesma chave pública do backend (VAPID_PUBLIC_KEY)
# VITE_VAPID_PUBLIC_KEY=

# Produção Baturité + plataforma CâmaraGest (Stellar / Hostinger)
# VITE_API_URL=https://apibaturite.stellarsolucoes.com.br/api
# VITE_SOCKET_URL=https://apibaturite.stellarsolucoes.com.br
# VITE_PLATFORM_HOSTS=camaragest.stellarsolucoes.com.br
# Guia: docs/deploy-vps.md
# WebSocket (opcional — se omitido, deriva da VITE_API_URL removendo /api)
# VITE_SOCKET_URL=https://sua-api.com
# VITE_APP_VERSION=1.0.0
# Rodapé — powered by
# VITE_POWERED_BY=Stellar
# VITE_POWERED_BY_URL=https://stellarsolucoes.com.br
